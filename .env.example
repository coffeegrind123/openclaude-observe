# Env vars for OpenClaude Observe
#
# All server config is centralized in app/server/src/config.ts — every var
# below (except OPENCLAUDE_OBSERVE_DATA_DIR, which is compose-only) is read there.
#
# Copy to .env at the repo root to override defaults for `just dev`, `just
# start-local`, or `docker compose up openclaude-observe`. In a worktree,
# give each copy its own ports.

# ── Server ──────────────────────────────────────────────
OPENCLAUDE_OBSERVE_SERVER_PORT=4981            # API + UI port (also exposed by Docker)
OPENCLAUDE_OBSERVE_LOG_LEVEL=warn              # warn | debug | trace
OPENCLAUDE_OBSERVE_RUNTIME=docker              # docker | local | dev
OPENCLAUDE_OBSERVE_SHUTDOWN_DELAY_MS=30000     # Auto-shutdown after last consumer disconnects; 0 disables
# OPENCLAUDE_OBSERVE_NOTIFICATION_ON_EVENTS=Notification   # Comma-separated event subtypes that raise a
                                                       # notification (e.g. "Notification,Stop,SubagentStop")

# ── Data ────────────────────────────────────────────────
OPENCLAUDE_OBSERVE_DB_PATH=data/observe.db     # SQLite database path (inside the container: /data/observe.db)
OPENCLAUDE_OBSERVE_ALLOW_DB_RESET=backup       # allow | backup | deny — policy for DELETE /api/data
# OPENCLAUDE_OBSERVE_STORAGE_ADAPTER=sqlite    # Storage backend (currently only sqlite)
# OPENCLAUDE_OBSERVE_DATA_DIR also holds the models.dev pricing cache (defaults to the DB dir)

# ── Transcript token stats ──────────────────────────────
# On-demand parse of ~/.claude/projects JSONL transcripts for per-prompt /
# per-model token + cost breakdowns in the session Stats tab.
OPENCLAUDE_OBSERVE_TRANSCRIPT_STATS=1          # 1 (default) enables; 0 disables
# Docker only: the host transcripts dir is mounted read-only into the container
# and host paths in the DB are translated to the container mount path.
# OPENCLAUDE_OBSERVE_TRANSCRIPT_CLAUDE_HOST_BASE=/custom/.claude/projects   # defaults to $HOME/.claude/projects
# OPENCLAUDE_OBSERVE_TRANSCRIPT_CLAUDE_CONTAINER_BASE=/host/.claude/projects

# ── Dev-mode only (just dev) ────────────────────────────
OPENCLAUDE_OBSERVE_DEV_CLIENT_PORT=5174        # Vite dev server port for the dashboard UI

# ── Docker compose only ─────────────────────────────────
# OPENCLAUDE_OBSERVE_DATA_DIR=./data           # Host directory bind-mounted into the container at /data
# OPENCLAUDE_OBSERVE_CLIENT_DIST_PATH=         # Override the client dist directory (normally auto-detected)
