# Env vars for instantcoffee-observe
#
# All server config is centralized in app/server/src/config.ts — every var
# below (except INSTANTCOFFEE_OBSERVE_DATA_DIR, which is compose-only) is read there.
#
# Copy to .env at the repo root to override defaults for `just dev`, `just
# start-local`, or `docker compose up instantcoffee-observe`. In a worktree,
# give each copy its own ports.

# ── Server ──────────────────────────────────────────────
INSTANTCOFFEE_OBSERVE_SERVER_PORT=4981            # API + UI port (also exposed by Docker)
INSTANTCOFFEE_OBSERVE_LOG_LEVEL=warn              # warn | debug | trace
INSTANTCOFFEE_OBSERVE_RUNTIME=docker              # docker | local | dev
# The dashboard, API and WebSocket are unauthenticated, so everything below
# defaults to this machine only.
# INSTANTCOFFEE_OBSERVE_BIND=127.0.0.1            # Docker: host interface the port is published on (0.0.0.0 = LAN)
# INSTANTCOFFEE_OBSERVE_SERVER_HOST=127.0.0.1     # Local/dev: interface the server listens on
# INSTANTCOFFEE_OBSERVE_CORS_ORIGINS=             # Browser origin allowlist (comma-separated); unset = loopback only, * = any
# INSTANTCOFFEE_OBSERVE_NOTIFICATION_ON_EVENTS=Notification   # Comma-separated event subtypes that raise a
                                                       # notification (e.g. "Notification,Stop,SubagentStop")

# ── Data ────────────────────────────────────────────────
INSTANTCOFFEE_OBSERVE_DB_PATH=data/observe.db     # SQLite database path (inside the container: /data/observe.db)
INSTANTCOFFEE_OBSERVE_ALLOW_DB_RESET=backup       # allow | backup | deny — policy for DELETE /api/data
# INSTANTCOFFEE_OBSERVE_STORAGE_ADAPTER=sqlite    # Storage backend (currently only sqlite)
# The models.dev pricing cache lives next to the DB
# INSTANTCOFFEE_OBSERVE_MAX_IMAGE_DATA_CHARS=1024 # base64 image runs longer than this are redacted at ingestion; 0 disables

# ── pi ──────────────────────────────────────────────────
# pi homes whose .pi/agent holds sessions (transcripts), context files and
# subagent definitions. Comma-separated. Defaults to $HOME. In docker, compose
# builds this from the two home mounts below.
# INSTANTCOFFEE_OBSERVE_PI_HOMES=/home/me,/home/piuser
INSTANTCOFFEE_OBSERVE_TRANSCRIPT_STATS=1          # session stats parsed from pi's JSONL transcripts; 0 disables
INSTANTCOFFEE_OBSERVE_INSTRUCTIONS=1              # Instructions browser/editor (writes AGENTS.md, agents/*.md); 0 disables

# ── Inference stack ─────────────────────────────────────
# llama-server /metrics (decode speed, draft acceptance, cache reuse) and forge
# /forge/usage (context fill). Default host: localhost, or host.docker.internal
# in docker.
# INSTANTCOFFEE_OBSERVE_LLAMA_URL=http://127.0.0.1:8080
# INSTANTCOFFEE_OBSERVE_FORGE_URL=http://127.0.0.1:8081
# INSTANTCOFFEE_OBSERVE_STACK_POLL_MS=5000        # 0 disables polling

# ── Dev-mode only (just dev) ────────────────────────────
INSTANTCOFFEE_OBSERVE_DEV_CLIENT_PORT=5174        # Vite dev server port for the dashboard UI

# ── Docker compose only ─────────────────────────────────
# Docker Desktop on WSL: mount sources must be Windows-side paths (//c/...).
# INSTANTCOFFEE_OBSERVE_DATA_DIR=./data           # Host directory bind-mounted into the container at /data
# INSTANTCOFFEE_OBSERVE_CLIENT_DIST_PATH=         # Override the client dist directory (normally auto-detected)
# INSTANTCOFFEE_OBSERVE_HOST_DB_PATH=             # DB path shown in the dashboard (default $INSTANTCOFFEE_OBSERVE_DATA_DIR/observe.db)
# SELinux hosts (Fedora/RHEL/openSUSE): relabel the bind mounts so the container
# can open them (SQLITE_CANTOPEN otherwise). Leave unset on Docker Desktop/macOS.
# The pi-home option relabels the ENTIRE home recursively.
# INSTANTCOFFEE_OBSERVE_DATA_MOUNT_OPTS=rw,z
# INSTANTCOFFEE_OBSERVE_PI_HOME_MOUNT_OPTS=rw,z
# The host pi's home, mounted at the same absolute path pi reports:
# INSTANTCOFFEE_OBSERVE_PI_HOME=/home/me          # path as pi sees it (default $HOME)
# INSTANTCOFFEE_OBSERVE_PI_HOME_HOST=/home/me     # mount source (default $HOME)
# instantcoffee's containerised pi (scripts/pi-container.sh) and its own home:
# INSTANTCOFFEE_OBSERVE_PI_CONTAINER_HOME=/home/piuser
# INSTANTCOFFEE_OBSERVE_PI_CONTAINER_HOME_HOST=/path/to/PI_CONTAINER_HOME_HOST
